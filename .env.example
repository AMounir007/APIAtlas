# Copy to .env and fill in real values. Never commit .env.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
MITM_INGEST_TOKEN=change-me-to-a-random-token
ATLAS_ADMIN_USER=admin
ATLAS_ADMIN_PASSWORD=change-me
GRAFANA_PASSWORD=change-me
# Restrict web discovery to these hosts (comma-separated, subdomains included). Recommended in every shared environment.
ATLAS_ALLOWED_HOSTS=
# Internal/private/loopback targets are blocked (SSRF protection). Set true only for local test environments.
ATLAS_ALLOW_PRIVATE_TARGETS=false
# Optional AI enrichment
AI_ENABLED=false
AI_API_KEY=
