# Copy to .env and fill in real values. Never commit .env.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
MITM_INGEST_TOKEN=change-me-to-a-random-token
ATLAS_ADMIN_USER=admin
ATLAS_ADMIN_PASSWORD=change-me
GRAFANA_PASSWORD=change-me
# Restrict web discovery to these hosts (comma-separated, subdomains included). Empty = allow all.
ATLAS_ALLOWED_HOSTS=
# Optional AI enrichment
AI_ENABLED=false
AI_API_KEY=
